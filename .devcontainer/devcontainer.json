{
	"name": "NVIDIA GPU Container (compose)",
	// 1. docker-compose へ移行
	"dockerComposeFile": [
		"../docker-compose.yml"
	],
	"service": "dev",
	"workspaceFolder": "/workspace",
	// pyproject.toml に dependencies 書いているので requirements.txt は不要？
	"postCreateCommand": "bash -lc 'set -euo pipefail; if [ ! -d .venv ]; then python3 -m venv .venv; fi; source .venv/bin/activate; python -m pip install -U pip setuptools wheel; python -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124; python -m pip install -e .'",
	// 2. VSCodeの設定
	"customizations": {
		"vscode": {
			// コンテナ内で自動的にインストールする拡張機能
			"extensions": [
				"ms-python.python", // Python
				"ms-toolsai.jupyter", // Jupyter Notebook
				"ms-vscode.cpptools", // C/C++
				"eamodio.gitlens", // GitLens
				"njpwerner.autodocstring" // Python Docstring Generator
			],
			// コンテナ内のVSCodeの設定
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"python.defaultInterpreterPath": "/workspace/.venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"python.analysis.autoImportCompletions": true,
				"python.analysis.extraPaths": [
					"${containerWorkspaceFolder}"
				]
			}
		}
	},
	//
	"shutdownAction": "stopCompose"
}