{
	"name": "NVIDIA GPU Container",
	// 1. Dockerfileの指定
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		// Dockerfile内のARGに変数を渡す
		"args": {
			// ローカル環境のユーザー名やIDをコンテナ内のユーザーに合わせる
			// これにより、ファイルのパーミッション問題を防ぎやすくなります。
			"USERNAME": "${localEnv:USER}",
			"USER_UID": "1000",
			"USER_GID": "1000"
		}
	},
	// 2. GPUを有効にするための実行時引数 ★最重要★
	// これにより、コンテナがホストマシンの全GPUにアクセスできるようになります。
	"runArgs": [
		"--gpus",
		"all",
		// （任意）大規模なデータを扱う場合、共有メモリサイズを増やすと効果的なことがあります
		"--shm-size=1g"
	],
	// 3. VSCodeの設定
	"customizations": {
		"vscode": {
			// コンテナ内で自動的にインストールする拡張機能
			"extensions": [
				"ms-python.python", // Python
				"ms-toolsai.jupyter", // Jupyter Notebook
				"ms-vscode.cpptools", // C/C++
				"eamodio.gitlens", // GitLens
				"njpwerner.autodocstring" // Python Docstring Generator
			],
			// コンテナ内のVSCodeの設定
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"python.defaultInterpreterPath": "/usr/bin/python3",
				"python.analysis.autoImportCompletions": true,
				"python.analysis.extraPaths": [
					"${containerWorkspaceFolder}",
					"./sslcompare"
				]
			}
		}
	},
	// 4. ワークスペースのマウント設定
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	// 5. コンテナに接続するユーザー
	"remoteUser": "${localEnv:USER}",
	"remoteEnv": {
		"PYTHONPATH": "${containerWorkspaceFolder}/sslcompare:${PYTHONPATH}"
	}
}